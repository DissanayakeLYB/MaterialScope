# ── Supabase (required for auth + lesson progress) ──────────────────────────
# Get these from your Supabase project:
#   Dashboard → Project Settings → API → Project URL and anon public key.
# Use the "anon public" key — never the service_role key (it bypasses Row
# Level Security and would expose every user's data).
#
# Local development: copy this file to .env.local and fill in the values.
# Production (Vercel): set the same variables in the Vercel dashboard
# (Project → Settings → Environment Variables) — see README.md → Deploying to
# Vercel. This file never ships to Vercel (it is gitignored).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ── Canonical site origin ────────────────────────────────────────────────────
# Used as the base for OAuth redirect URLs, Open Graph links, sitemap.xml,
# and robots.txt.
#   - Local development: leave as http://localhost:3000.
#   - Production (Vercel): MUST be your real deployment URL, e.g.
#     https://materialscope.vercel.app (or your custom domain once connected).
#     Set it in the Vercel dashboard — do not rely on the localhost fallback.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
