# Supabase (copy to .env.local and fill in — see README → Supabase setup)
#
# Get these from your Supabase project: Dashboard → Project Settings → API.
# - Project URL is the "Project URL" field.
# - anon key is the "anon public" key (NOT the service_role key — it bypasses
#   Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: used as the base for OAuth redirect URLs. Defaults to the request
# origin when unset.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
